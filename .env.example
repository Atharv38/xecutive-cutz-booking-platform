# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (Required for Cloud PostgreSQL, Auth, Storage, & Edge Functions)
# When absent, Xecutive Cutz runs on the built-in local SQLite demo engine with explicit status indicators.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# TRANSACTIONAL EMAILS (Resend API for booking confirmations & admin notifications)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Xecutive Cutz <bookings@xecutivecutz.com>"

# SESSION SECRET (Local Express demo session signing key)
SESSION_SECRET=""

# GOOGLE MAPS PLATFORM (Maps JavaScript API & Routes API)
VITE_GOOGLE_MAPS_API_KEY=""
